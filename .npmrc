# The Node pin in .nvmrc and package.json#engines is advisory to npm unless this
# is set. Without it, running under the wrong Node fails much later and much
# further from the cause: Node < 22.12 has no unflagged `require(esm)`, so jsdom
# 30 takes down every vitest worker with a bare ERR_REQUIRE_ESM inside
# node_modules, which reads as a broken test config rather than a wrong runtime.
# See the Sept 15 entry in TASKS.md. Prefer `nvm use` in this directory.
engine-strict=true
